{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "utilwise-preview",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-11-05",
  "keep_vars": true,
  "compatibility_flags": ["nodejs_compat", "nodejs_compat_populate_process_env"],
  "assets": { "directory": ".open-next/assets", "binding": "ASSETS" },
  "d1_databases": [{
    "binding": "BLOG_DB",
    "database_name": "utilwise-blog",
    "database_id": "607946e3-d4cd-4cce-b7e9-eaf515244cb4",
    "preview_database_id": "5e457e52-0612-4103-80d0-4eec0933c126",
    "migrations_dir": "migrations"
  }],
  "previews": {
    "d1_databases": [{
      "binding": "BLOG_DB",
      "database_id": "5e457e52-0612-4103-80d0-4eec0933c126"
    }]
  },
  "r2_buckets": [{ "binding": "BLOG_IMAGES", "bucket_name": "utilwise-blog-images" }]
}
